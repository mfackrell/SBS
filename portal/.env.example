# Public app URL for redirects and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only define if a later integration explicitly requires it.
SUPABASE_JWT_SECRET=

# Keep this aligned with the Supabase Auth Email OTP Expiration setting.
INVITE_EXPIRES_MINUTES=60

# Invite email provider. Leave blank when using Supabase-managed auth email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Security and upload configuration used by later phases.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
FILE_UPLOAD_MAX_MB=25
ALLOWED_MIME_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg

# QBO is link/reference only. No payment processing occurs in this app.
QBO_BILLING_BASE_URL=

# Optional comma-separated feature flags.
FEATURE_FLAGS=
