# Public app URL for redirects and invite links.
# On Vercel production this resolves to https://portal.contract-cfo.com when omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Vercel's Supabase integration may provide NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel's Supabase integration may provide SUPABASE_SECRET_KEY instead.
SUPABASE_SECRET_KEY=

# Optional. Only define if a later integration explicitly requires it.
SUPABASE_JWT_SECRET=

# Keep this aligned with the Supabase Auth Email OTP Expiration setting.
INVITE_EXPIRES_MINUTES=60

# Server-to-server lead intake authentication and privacy-preserving rate-limit hashing.
LEAD_INGEST_SHARED_SECRET=
LEAD_RATE_LIMIT_SALT=
SECURITY_RATE_LIMIT_SALT=

# Branded portal invitation email.
RESEND_API_KEY=
PORTAL_EMAIL_FROM=Strategic Business Services <portal@contract-cfo.com>
PORTAL_EMAIL_REPLY_TO=mfackrell@contract-cfo.com

# QuickBooks Online read-only integration.
# Use sandbox credentials until the Intuit production-key questionnaire is approved.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# 32 random bytes, encoded as base64, or a 64-character hex value.
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
# Separate random value of at least 32 characters used to sign OAuth state.
QUICKBOOKS_STATE_SECRET=
# Optional until webhooks are enabled in the Intuit developer dashboard.
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
# Vercel Cron authentication. Vercel can provide this automatically when configured.
CRON_SECRET=

# Security and upload configuration.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
FILE_UPLOAD_MAX_MB=25
ALLOWED_MIME_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg

# QuickBooks billing/reference link only; separate from the accounting-data OAuth integration.
QBO_BILLING_BASE_URL=

# Optional comma-separated feature flags.
FEATURE_FLAGS=
